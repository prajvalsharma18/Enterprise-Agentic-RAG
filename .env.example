# Copy this file to .env and fill in your values
# Never commit .env to git

# LLM provider: openai (default) or ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna


# Qdrant 
VECTOR_STORE=
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=

# For host-run local development, use http://localhost:6333.
# For the optional Compose-local service, use http://qdrant:6333 and
# start it with: docker compose --profile local up

# Tavily web search API key (free at https://tavily.com)
TAVILY_API_KEY=tvly-your-key-here
